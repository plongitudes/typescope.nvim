# Stands in for an installed package: a class with structure of its own.
# Nested as a member's type it stays expandable; hovered directly, or opened
# on demand, it draws (design/oracle.md §4, the SQLAlchemy Column rule).
class Widget:
    size: int
    label: str
    def render(self) -> str: ...


# Everything on it is a dunder, so opening it would draw nothing: nested as a
# member's type it is a plain leaf, not an expandable that opens to empty (an
# ASGI app protocol is just `__call__`).
class Opaque:
    def __init__(self, scope: dict) -> None: ...
    def __call__(self, x: int) -> None: ...
