scratch/
.DS_Store
/.beads
/.claude

# generated by :helptags; every plugin manager regenerates it on install
doc/tags

# design docs and captures live in scratch/; never track binaries at the root
*.pdf
*.mov

# pyrefly at the commit in oracle/pyrefly.rev, fetched by scripts/build-oracle.sh
/oracle/vendor/pyrefly/

# the demo's capture, its VHS preview frames, its mp4 (a GitHub upload), and its stills (on the assets branch)
/demo/capture.*
/demo/frames/
/demo/*.mp4
/demo/*.gif
/demo/shots/
# demo/record.sh builds it from demo/requirements.txt
/demo/.venv/
